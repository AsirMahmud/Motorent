generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GENERAL
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleCategory {
  BIKE
  CAR
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  phone                String             @unique
  passwordHash         String?
  googleId             String?            @unique
  fullName             String
  role                 UserRole           @default(GENERAL)
  verificationStatus   VerificationStatus @default(PENDING)
  nidOrPassportUrl     String?
  drivingLicenseUrl    String?
  ownershipPaperUrl    String?
  passportPhotoUrl     String?
  verificationNote     String?
  verificationReviewedAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  vehicles             Vehicle[]
  bookingsAsRenter     Booking[]          @relation("RenterBookings")
}

model Vehicle {
  id                 String          @id @default(cuid())
  ownerId            String
  owner              User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category           VehicleCategory @default(BIKE)
  brand              String
  model              String
  year               Int
  registrationNumber String
  location           String          @default("Dhaka, Bangladesh")
  seats              Int             @default(2)
  fuelType           String          @default("gasoline")
  transmission       String          @default("manual")
  description        String?         @db.Text
  features           String[]        @default([])
  dailyRate          Int
  priceHourly        Int?
  priceWeekly        Int?
  vehiclePhotoUrl    String
  ownershipPaperUrl  String
  insurancePaperUrl  String?
  status             VehicleStatus   @default(PENDING)
  reviewNote         String?
  reviewedAt         DateTime?
  viewCount          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  bookings           Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  renterId        String
  renter          User          @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  pickupTime      String?
  totalPrice      Int
  status          BookingStatus @default(PENDING)
  pickupLocation  String
  dropoffLocation String?
  notes           String?
  ownerDecidedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([vehicleId])
  @@index([renterId])
  @@index([status])
}

model LandingPageContent {
  id                String   @id @default("singleton")
  heroTitle         String   @default("Ride the Extraordinary.")
  heroSubtitle      String   @default("Experience the ultimate freedom of movement. From high-performance bikes to luxury SUVs, find the perfect ride for every journey.")
  heroCtaText       String   @default("Explore Vehicles")
  stats             Json?    // Array of { label, value, icon }
  features          Json?    // Array of { title, description, icon, color }
  categories        Json?    // Array of { name, count, image, link }
  faqs              Json?    // Array of { q, a }
  updatedAt         DateTime @updatedAt
}
