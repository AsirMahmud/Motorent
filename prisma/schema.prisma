generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GENERAL
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VehicleCategory {
  BIKE
  CAR
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  phone                String             @unique
  passwordHash         String?
  googleId             String?            @unique
  fullName             String
  role                 UserRole           @default(GENERAL)
  verificationStatus   VerificationStatus @default(PENDING)
  nidOrPassportUrl     String?
  drivingLicenseUrl    String?
  ownershipPaperUrl    String?
  passportPhotoUrl     String?
  verificationNote     String?
  verificationReviewedAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  vehicles             Vehicle[]
  bookingsAsRenter     Booking[]          @relation("RenterBookings")
  messagesSent         Message[]          @relation("BookingMessageSender")
  directMessagesSent   DirectMessage[]    @relation("DirectMessageFrom")
  directMessagesRecv   DirectMessage[]    @relation("DirectMessageTo")
}

model Vehicle {
  id                 String          @id @default(cuid())
  ownerId            String
  owner              User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category           VehicleCategory @default(BIKE)
  brand              String
  model              String
  year               Int
  registrationNumber String
  location           String          @default("Dhaka, Bangladesh")
  /** Pickup / listing pin for the explore map; optional when geocoding from `location` is enough */
  latitude           Float?
  longitude          Float?
  seats              Int             @default(2)
  fuelType           String          @default("gasoline")
  transmission       String          @default("manual")
  description        String?         @db.Text
  features           String[]        @default([])
  dailyRate          Int
  priceHourly        Int?
  priceWeekly        Int?
  vehiclePhotoUrl    String
  ownershipPaperUrl  String
  insurancePaperUrl  String?
  isActive           Boolean         @default(true)
  status             VehicleStatus   @default(PENDING)
  reviewNote         String?
  reviewedAt         DateTime?
  viewCount          Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  bookings           Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  renterId        String
  renter          User          @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  pickupTime      String?
  totalPrice      Int
  status          BookingStatus @default(PENDING)
  pickupLocation  String
  dropoffLocation String?
  notes           String?
  ownerDecidedAt  DateTime?
  pickedUpAt      DateTime?
  returnedAt      DateTime?
  returnCondition String?
  returnNotes     String?       @db.Text
  lateFee         Int           @default(0)
  damageFee       Int           @default(0)
  finalAmount     Int?
  paymentReceivedAt DateTime?
  renterLat       Float?
  renterLng       Float?
  renterLocUpdatedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        Message[]

  @@index([vehicleId])
  @@index([renterId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("BookingMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([bookingId])
}

model DirectMessage {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  body      String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  from      User     @relation("DirectMessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User     @relation("DirectMessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId, toId])
  @@index([toId, read])
}
