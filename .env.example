# Environment example for Motorent
# Copy this to .env.local (or your environment) and fill in real values.
# Do NOT commit real secrets.

# Database (Postgres)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/motorent?schema=public"

# JWT / NextAuth
# Use long, random secrets in production (at least 32 chars)
JWT_SECRET="__GENERATE_A_STRONG_JWT_SECRET__"
NEXTAUTH_SECRET="__GENERATE_A_STRONG_NEXTAUTH_SECRET__"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (Google) - required only if using Google sign-in
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# UploadThing (file uploads)
UPLOADTHING_TOKEN="your-uploadthing-token"

# Outbound email (Nodemailer) — renter/vehicle approval notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="no-reply@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Motorent <no-reply@example.com>"

# Optional: enable debug logging for email (true/false)
# SMTP_DEBUG=false

# Notes:
# - Replace placeholder values with real secrets in a local-only .env file (e.g., .env.local).
# - Keep secrets out of version control; use secret management in production (e.g., GitHub Secrets, environment variables on the host).
# - For JWT/NEXTAUTH secrets, use a long random string (32+ characters) generated securely.
